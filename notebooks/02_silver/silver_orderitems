from pyspark.sql import functions as F

# load bronze
df = spark.table("retail_lakehouse.bronze.order_items")
df.show(10, truncate=False)
df.printSchema()

bronze_count = df.count()
print("Bronze row count:", bronze_count)

# null check
df.select([
    F.sum(F.when(F.col(c).isNull(), 1).otherwise(0)).alias(c)
    for c in df.columns
]).show()

# duplicate check on composite key
df.groupBy("order_id", "order_item_id") \
    .agg(F.count("*").alias("cnt")) \
    .filter(F.col("cnt") > 1) \
    .show()

# load silver tables for orphan checks
orders_df = spark.table("retail_lakehouse.silver.orders")
products_df = spark.table("retail_lakehouse.silver.products")
sellers_df = spark.table("retail_lakehouse.silver.sellers")

# orphan key checks
orphan_orders = df.join(orders_df, on="order_id", how="left_anti")
orphan_products = df.join(products_df, on="product_id", how="left_anti")
orphan_sellers = df.join(sellers_df, on="seller_id", how="left_anti")

print("orphan orders:", orphan_orders.count())
print("orphan products:", orphan_products.count())
print("orphan sellers:", orphan_sellers.count())

# price and freight ranges
df.select(
    F.min("price").alias("min_price"),
    F.max("price").alias("max_price"),
    F.min("freight_value").alias("min_freight"),
    F.max("freight_value").alias("max_freight")
).show()

# zero or negative values
invalid_values = df.filter(
    (F.col("price") <= 0) | (F.col("freight_value") < 0)
)
print("Zero/negative price or negative freight:", invalid_values.count())
invalid_values.show(20, truncate=False)

# decide cleaning after checking results above
silver_df = df

# row count check
silver_count = silver_df.count()
print("Bronze:", bronze_count, "Silver:", silver_count)
assert bronze_count == silver_count, "Row count mismatch"

# write to silver
silver_df.write \
    .format("delta") \
    .mode("overwrite") \
    .saveAsTable("retail_lakehouse.silver.order_items")

# verify write
check_df = spark.table("retail_lakehouse.silver.order_items")
print("Final Silver row count:", check_df.count())
check_df.show(5, truncate=False)